# 应用
APP_NAME=agno-platform
APP_ENV=development        # development | production
LOGGER_LEVEL=INFO

# 数据库（必填）
# 开发用 SQLite
DATABASE_URL=sqlite:///./local.db
# 生产用 PostgreSQL
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/agno_platform

# 向量库（留空则复用 DATABASE_URL）
VECTOR_DB_URL=

# Embedder
EMBEDDER_BASE_URL=
EMBEDDER_API_KEY=
EMBEDDER_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDER_DIMENSIONS=1024

# CORS（JSON 数组格式）
API_CORS_ORIGINS=["http://localhost:5173"]

# Skill 市场
SKILL_MARKET_URL=https://api.github.com/repos/agno-agi/agno/contents/cookbook/skills
